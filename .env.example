# Kopier til .env bare hvis du vil overstyre standardverdiene. Appen virker uten .env (NFR-1).
# Tomme verdier gir standardverdien. Legg aldri ekte verdier i denne fila (NFR-3).

# local | test | production. Standard: local
APP_ENV=
# Standard: sqlite:///./nabolagshelten.db
DATABASE_URL=
# Kreves i produksjon: tilfeldig og minst 32 tegn
SECRET_KEY=
# Valgfritt. Uten nøkkel brukes KI-mock (FR-26)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
